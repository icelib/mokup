{
  "name": "@mokup/cli",
  "type": "module",
  "version": "2.1.0",
  "description": "CLI for building mokup manifests and handlers.",
  "license": "MIT",
  "homepage": "https://mokup.icebreaker.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icelib/mokup.git",
    "directory": "packages/cli"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:types": "tsd"
  },
  "dependencies": {
    "@mokup/runtime": "workspace:*",
    "@mokup/server": "workspace:*",
    "@mokup/shared": "workspace:*",
    "commander": "^14.0.3",
    "yaml": "^2.9.1"
  },
  "tsd": {
    "compilerOptions": {
      "module": "NodeNext",
      "rootDir": "."
    }
  }
}
