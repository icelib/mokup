{
  "name": "@mokup/msw",
  "type": "module",
  "version": "0.1.0",
  "description": "Import-level HTTP migration facade from MSW-style APIs to Mokup.",
  "license": "MIT",
  "homepage": "https://mokup.icebreaker.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonofmagic/mokup.git",
    "directory": "packages/msw"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.mjs",
      "default": "./dist/http.mjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.mjs",
      "default": "./dist/node.mjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.mjs",
      "default": "./dist/browser.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "http": ["dist/http.d.ts"],
      "node": [
        "dist/node.d.ts"
      ],
      "browser": [
        "dist/browser.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "test:types": "tsd",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "tsd": {
    "compilerOptions": {
      "module": "NodeNext",
      "rootDir": "."
    }
  },
  "dependencies": {
    "mokup": "workspace:*"
  },
  "devDependencies": {
    "msw": "3.0.2"
  }
}
