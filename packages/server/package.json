{
  "name": "@mokup/server",
  "type": "module",
  "version": "2.0.1",
  "description": "Server adapters for @mokup/runtime.",
  "license": "MIT",
  "homepage": "https://mokup.icebreaker.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonofmagic/mokup.git",
    "directory": "packages/server"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./connect": {
      "types": "./dist/connect.d.ts",
      "import": "./dist/connect.mjs",
      "default": "./dist/connect.mjs"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.mjs",
      "default": "./dist/express.mjs"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.mjs",
      "default": "./dist/fastify.mjs"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "import": "./dist/fetch.mjs",
      "default": "./dist/fetch.mjs"
    },
    "./fetch-server": {
      "types": "./dist/fetch-server.d.ts",
      "import": "./dist/fetch-server.mjs",
      "default": "./dist/fetch-server.mjs"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.mjs",
      "default": "./dist/hono.mjs"
    },
    "./koa": {
      "types": "./dist/koa.d.ts",
      "import": "./dist/koa.mjs",
      "default": "./dist/koa.mjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.mjs",
      "default": "./dist/node.mjs"
    },
    "./worker-node": {
      "types": "./dist/worker-node.d.ts",
      "import": "./dist/worker-node.mjs",
      "default": "./dist/worker-node.mjs"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.mjs",
      "default": "./dist/worker.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "connect": [
        "dist/connect.d.ts"
      ],
      "express": [
        "dist/express.d.ts"
      ],
      "fastify": [
        "dist/fastify.d.ts"
      ],
      "fetch": [
        "dist/fetch.d.ts"
      ],
      "fetch-server": [
        "dist/fetch-server.d.ts"
      ],
      "hono": [
        "dist/hono.d.ts"
      ],
      "koa": [
        "dist/koa.d.ts"
      ],
      "node": [
        "dist/node.d.ts"
      ],
      "worker-node": [
        "dist/worker-node.d.ts"
      ],
      "worker": [
        "dist/worker.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:types": "tsd"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@mokup/core": "workspace:*",
    "@mokup/playground": "workspace:*",
    "@mokup/runtime": "workspace:*",
    "@mokup/shared": "workspace:*",
    "fastify-plugin": "^6.0.1",
    "ws": "^8.22.0"
  },
  "tsd": {
    "compilerOptions": {
      "module": "NodeNext",
      "rootDir": "."
    }
  },
  "devDependencies": {
    "@types/koa": "^3.0.3",
    "@types/ws": "^8.18.2",
    "fastify": "^5.12.7",
    "koa": "^3.2.1"
  }
}
