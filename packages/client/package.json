{
  "name": "@mokup/client",
  "type": "module",
  "version": "2.0.0",
  "description": "Client-side request switching and adapters for mokup.",
  "license": "MIT",
  "homepage": "https://mokup.icebreaker.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icelib/mokup.git",
    "directory": "packages/client"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./axios": {
      "types": "./dist/axios.d.ts",
      "import": "./dist/axios.mjs",
      "default": "./dist/axios.mjs"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "import": "./dist/fetch.mjs",
      "default": "./dist/fetch.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "axios": [
        "dist/axios.d.ts"
      ],
      "fetch": [
        "dist/fetch.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:types": "tsd"
  },
  "tsd": {
    "compilerOptions": {
      "module": "NodeNext",
      "rootDir": "."
    }
  }
}
