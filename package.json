{
  "name": "mokup-monorepo",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "author": "ice breaker <hi@sonofmagic.top>",
  "homepage": "https://mokup.icebreaker.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icelib/mokup.git"
  },
  "bugs": {
    "url": "https://github.com/icelib/mokup/issues"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "build:apps": "turbo run build --filter=./apps/*...",
    "dev": "turbo run dev --parallel",
    "docs:build": "turbo run build --filter=mokup-docs",
    "docs:deploy": "pnpm run docs:build && pnpm --filter mokup-docs exec wrangler deploy",
    "test": "vitest run",
    "test:dev": "vitest",
    "test:release-tools": "node --test scripts/test-repoctl-release.mjs",
    "test:types": "pnpm -r --filter \"./packages/*\" --filter \"!./packages/playground\" run test:types",
    "typecheck:fast": "pnpm -r --if-present --workspace-concurrency=8 run typecheck",
    "typecheck:root": "tsc -p tsconfig.root.json --noEmit",
    "guard:migration": "node scripts/check-migration-guards.mjs",
    "release:pack-check": "node scripts/check-pack-artifacts.mjs",
    "lint": "turbo run lint",
    "lint:lines": "node scripts/lint-lines.mjs",
    "lint:lines:warn": "node scripts/lint-lines.mjs --mode=warn",
    "lint:lines:guard": "node scripts/lint-lines.mjs --mode=guard",
    "audit": "pnpm audit --audit-level=moderate",
    "audit:fix": "pnpm audit --fix=override",
    "typecheck": "pnpm run typecheck:root && turbo run typecheck",
    "format": "eslint . --fix",
    "validate:fast": "pnpm run guard:migration && pnpm run typecheck:fast && pnpm run lint:lines:guard",
    "validate": "pnpm run guard:migration && pnpm run typecheck && pnpm run lint && pnpm run test",
    "test:e2e": "pnpm run test:e2e:root && pnpm run test:e2e:apps",
    "test:e2e:root": "playwright test",
    "test:e2e:apps": "turbo run test:e2e --filter=./apps/* --concurrency=${E2E_CONCURRENCY:-3}",
    "test:e2e:serial": "pnpm run test:e2e:root --workers=1 && pnpm run test:e2e:apps:serial",
    "test:e2e:apps:serial": "turbo run test:e2e --filter=./apps/* --concurrency=1",
    "test:e2e:ui": "pnpm run test:e2e:root --ui && pnpm run test:e2e:apps:ui",
    "test:e2e:apps:ui": "turbo run test:e2e --filter=./apps/* --concurrency=${E2E_CONCURRENCY:-3} -- --ui",
    "release": "pnpm change",
    "release:check": "pnpm run guard:migration && pnpm run lint:lines:guard && pnpm run test:release-tools && pnpm run typecheck && pnpm run build && pnpm run lint && pnpm run test && pnpm run test:types && pnpm run test:e2e:serial && pnpm run test:e2e:d1 && pnpm run release:pack-check && pnpm run test:mock-package-contract",
    "publish-packages": "repo release stable publish",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "pr:alpha": "repo release pre enter alpha",
    "pr:beta": "repo release pre enter beta",
    "pr:rc": "repo release pre enter rc",
    "pr:exit": "repo release pre exit",
    "script:init": "repo workspace init",
    "script:clean": "repo workspace clean",
    "script:mirror": "repo env mirror",
    "version-packages": "pnpm version -r",
    "release:plan": "repo release plan --markdown",
    "repo:init": "repo init",
    "repo:new": "repo new",
    "repo:check": "repo check",
    "repo:doctor": "repo doctor",
    "test:runtime": "node scripts/check-runtime-compat.mjs",
    "test:mock-package-contract": "node scripts/check-mock-package-contract.mjs",
    "test:vite-compat": "node scripts/check-vite-compat.mjs",
    "test:deployment-templates": "node scripts/check-deployment-templates.mjs",
    "test:provider-matrix": "node scripts/runtime-provider-smoke.mjs",
    "test:conformance": "playwright test --config playwright.conformance.config.ts",
    "bench:mocking": "node scripts/benchmark-mocking.mjs",
    "sync:npmmirror": "repo release sync-npmmirror --all",
    "release:sync-npmmirror": "repo release sync-npmmirror --published",
    "test:e2e:d1": "pnpm --filter mokup-d1-demo test:e2e:d1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@mokup/shared": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "catalog:",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "~5.0.5",
    "axios": "catalog:",
    "ci-info": "^4.4.0",
    "cross-env": "^10.1.0",
    "defu": "^6.1.7",
    "es-toolkit": "^1.52.0",
    "eslint": "^10.12.0",
    "execa": "^10.1.1",
    "fs-extra": "^11.4.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "only-allow": "^1.2.2",
    "pathe": "catalog:",
    "pkg-types": "^2.3.3",
    "repoctl": "^5.10.3",
    "rimraf": "^6.1.3",
    "semver": "^7.8.5",
    "stylelint": "^17.16.0",
    "tsd": "^0.33.0",
    "tsdown": "catalog:",
    "tslib": "^2.8.1",
    "tsx": "catalog:",
    "turbo": "^2.11.8",
    "type-fest": "^5.10.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "~5.0.5",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
