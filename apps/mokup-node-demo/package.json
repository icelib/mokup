{
  "name": "mokup-node-demo",
  "type": "module",
  "version": "0.0.28",
  "private": true,
  "homepage": "https://mokup.icebreaker.top",
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build:manifest": "pnpm --filter mokup build && node ../../packages/mokup/dist/cli-bin.mjs build --dir mock --out dist",
    "dev": "node --experimental-strip-types src/index.ts",
    "lint": "eslint .",
    "test:e2e": "node ../../tests/e2e/run-app-e2e.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@faker-js/faker": "catalog:",
    "@hono/node-server": "^2.1.5",
    "mokup": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
