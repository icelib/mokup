{
  "openapi": "3.1.0",
  "info": { "title": "Mokup starter", "version": "1.0.0" },
  "paths": {
    "/users": {
      "get": {
        "operationId": "listUsers",
        "responses": {
          "200": {
            "description": "Users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["id", "name"],
                    "additionalProperties": false,
                    "properties": {
                      "id": { "type": "string", "enum": ["1"] },
                      "name": { "type": "string", "enum": ["Ada"] }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
