{
  "name": "mokup-webpack-demo",
  "type": "module",
  "version": "0.0.21",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "tsx node_modules/webpack-cli/bin/cli.js serve --config webpack.config.ts --mode development",
    "build": "tsx node_modules/webpack-cli/bin/cli.js --config webpack.config.ts --mode production",
    "lint": "eslint .",
    "test:e2e": "node ../../tests/e2e/run-app-e2e.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@faker-js/faker": "catalog:",
    "mokup": "workspace:*",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@vue/compiler-sfc": "^3.5.43",
    "css-loader": "^7.1.5",
    "html-webpack-plugin": "^5.6.8",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vue-loader": "^17.4.2",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  }
}
