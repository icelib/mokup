{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mokup-website",
  "compatibility_date": "2025-01-15",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "docs/.vitepress/dist"
  },
  "routes": [
    {
      "pattern": "mokup.icebreaker.top",
      "custom_domain": true
    }
  ],
  "env": {
    "next": {
      "name": "mokup-website-next",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "next.mokup.icebreaker.top",
          "custom_domain": true
        }
      ]
    }
  }
}
